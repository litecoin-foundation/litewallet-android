<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/white"
        android:orientation="vertical"
        android:paddingStart="8dp"
        android:paddingEnd="8dp">

        <!-- Deprecation Warning -->
        <androidx.cardview.widget.CardView
            android:id="@+id/deprecation_warning_container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_marginTop="16dp"
            android:layout_marginEnd="12dp"
            app:cardCornerRadius="12dp"
            app:cardElevation="4dp">

            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/deprecation_warning_bg"
                android:padding="20dp">

                <!-- Warning Icon -->
                <ImageView
                    android:id="@+id/warning_icon"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:src="@drawable/ic_error_outline_black_24dp"
                    android:tint="#FFCC00"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent" />

                <!-- Title -->
                <TextView
                    android:id="@+id/deprecation_title"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:layout_marginEnd="40dp"
                    android:fontFamily="@font/barlowsemicondensed_bold"
                    android:text="Important Notice"
                    android:textColor="#FFCC00"
                    android:textSize="18sp"
                    app:layout_constraintEnd_toStartOf="@+id/deprecation_close_button"
                    app:layout_constraintStart_toEndOf="@+id/warning_icon"
                    app:layout_constraintTop_toTopOf="parent" />

                <!-- Message -->
                <TextView
                    android:id="@+id/deprecation_warning_text"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:layout_marginEnd="40dp"
                    android:fontFamily="@font/barlowsemicondensed_medium"
                    android:lineSpacingExtra="2dp"
                    android:text="Litewallet is no longer being maintained. Please upgrade to Nexus Wallet for continued Litecoin support and new features."
                    android:textColor="#E6FFCC00"
                    android:textSize="15sp"
                    app:layout_constraintEnd_toStartOf="@+id/deprecation_close_button"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/deprecation_title" />

                <!-- Button Container -->
                <LinearLayout
                    android:id="@+id/deprecation_button_container"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="20dp"
                    android:orientation="horizontal"
                    android:weightSum="2"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/deprecation_warning_text">

                    <Button
                        android:id="@+id/get_nexus_wallet_button"
                        android:layout_width="0dp"
                        android:layout_height="48dp"
                        android:layout_marginEnd="10dp"
                        android:layout_weight="1"
                        android:background="@drawable/nexus_primary_button_bg"
                        android:fontFamily="@font/barlowsemicondensed_semibold"
                        android:text="Get Nexus Wallet"
                        android:textAllCaps="false"
                        android:textColor="#FFCC00"
                        android:textSize="15sp" />

                    <Button
                        android:id="@+id/learn_more_button"
                        android:layout_width="0dp"
                        android:layout_height="48dp"
                        android:layout_marginStart="10dp"
                        android:layout_weight="1"
                        android:background="@drawable/nexus_secondary_button_bg"
                        android:fontFamily="@font/barlowsemicondensed_medium"
                        android:text="Learn More"
                        android:textAllCaps="false"
                        android:textColor="#CCFFCC00"
                        android:textSize="15sp" />

                </LinearLayout>

                <!-- Close Button -->
                <ImageButton
                    android:id="@+id/deprecation_close_button"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:background="@drawable/close_button_bg"
                    android:padding="6dp"
                    android:src="@drawable/ic_close_white_24dp"
                    android:tint="#FFCC00"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toTopOf="parent" />

            </androidx.constraintlayout.widget.ConstraintLayout>

        </androidx.cardview.widget.CardView>

        <!-- Main Content Container -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/recyclerView"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:clipToPadding="false"
                android:paddingStart="8dp"
                android:paddingTop="16dp"
                android:paddingEnd="8dp"
                android:paddingBottom="8dp"
                tools:listitem="@layout/tx_item" />

            <TextView
                android:id="@+id/empty_tx_tip"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:fontFamily="@font/barlowsemicondensed_regular"
                android:text="@string/TransactionDetails.emptyMessage"
                android:textColor="@color/light_gray"
                android:textSize="18sp"
                android:visibility="gone"
                tools:visibility="visible" />

        </FrameLayout>

    </LinearLayout>
</layout>